{
  "name": "country-calendar",
  "private": true,
  "version": "5.0.0",
  "description": "Update-safe static Country Calendar dashboard",
  "scripts": {
    "build": "node tools/build.mjs",
    "validate": "npm run build && node tools/validate-data.mjs && node tools/relevance-test.mjs && node tools/news-quality-test.mjs && node tools/news-bundles-test.mjs && node tools/web-ngrams-test.mjs && node tools/discovery-news-test.mjs && node tools/official-news-test.mjs && node tools/smoke-test.mjs && node tools/standalone-smoke-test.mjs",
    "refresh:news": "node tools/update-news.mjs",
    "refresh:economic": "node tools/update-economic.mjs --scope=all",
    "refresh:macro": "node tools/update-economic.mjs --scope=macro",
    "refresh:trade": "node tools/update-economic.mjs --scope=trade",
    "import:commodity": "node tools/update-economic.mjs --scope=commodity",
    "ingest:webngrams": "node tools/ingest-web-ngrams.mjs",
    "review:timeline": "node tools/build-review-queues.mjs --mode=weekly",
    "review:structured": "node tools/build-review-queues.mjs --mode=structured",
    "review:backfill": "node tools/build-review-queues.mjs --mode=backfill"
  }
}
